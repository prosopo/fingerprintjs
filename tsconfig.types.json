{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"emitDeclarationOnly": true,
		"outDir": "./dist/types",
		"tsBuildInfoFile": null,
		"declaration": true,
		"declarationMap": true,
		"composite": false
	},
	"exclude": [
		"**/*.test.ts",
		"**/*.spec.ts",
		"tests/**/*",
		"vitest.setup.ts",
		"vitest.config.ts"
	]
}
